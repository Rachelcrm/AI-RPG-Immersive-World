DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,testserver
DJANGO_TIME_ZONE=America/New_York

# AWS RDS PostgreSQL (or local Postgres)
# Example: postgresql://postgres:postgres@localhost:5432/rpg_db
DATABASE_URL=sqlite:///db.sqlite3

# MongoDB Atlas
# Example: mongodb+srv://user:password@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=rpg_game

# LLM provider: anthropic | openai (empty = anthropic if ANTHROPIC_API_KEY is set)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RPG_OUTPUT_LANGUAGE=English
TRADE_TAX_RATE=0.05

# Production only
# DJANGO_CSRF_TRUSTED_ORIGINS=https://rpg.example.com
# GUNICORN_WORKERS=3

# Folder of .txt books the web UI (http://127.0.0.1:8000/) lists. Default: rpg_engine/samples
BOOKS_DIR=
# Group short chapters into ~N-character units before summarising (0 = one summary per chapter)
CHAPTER_GROUP_CHARS=12000

# Prose rules for the narrator (edited live, no restart). Defaults to prompts/narrator_style.md
# NARRATOR_STYLE_FILE=prompts/narrator_style.md
